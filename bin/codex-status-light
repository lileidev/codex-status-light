#!/usr/bin/env python3
"""Update one Codex session's desktop status light atomically."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import pathlib
import re
import sys
import tempfile

VALID_STATES = ("running", "waiting", "done", "error")


def safe_session_id(value: str) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9_.-]+", "-", value).strip("-.")
    return cleaned[:160] or "default"


def default_state_dir() -> pathlib.Path:
    override = os.environ.get("CODEX_STATUS_LIGHT_DIR")
    if override:
        return pathlib.Path(override).expanduser()
    return pathlib.Path.home() / ".codex" / "status-light" / "sessions"


def write_state(
    state: str,
    session_id: str,
    message: str = "",
    cwd: str = "",
    turn_id: str | None = None,
    source: str = "cli",
    state_dir: pathlib.Path | None = None,
    is_streaming: bool = False,
) -> pathlib.Path:
    if state not in VALID_STATES:
        raise ValueError(f"Invalid state {state!r}. Must be one of {VALID_STATES}")

    state_dir = state_dir or default_state_dir()
    state_dir.mkdir(parents=True, exist_ok=True)

    target = state_dir / f"{safe_session_id(session_id)}.json"
    payload = {
        "session_id": session_id,
        "turn_id": turn_id,
        "state": state,
        "message": message or state.capitalize(),
        "cwd": cwd or os.getcwd(),
        "updated_at": dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z"),
        "source": source,
        "is_streaming": is_streaming,
    }

    fd, temporary = tempfile.mkstemp(prefix=".status-", suffix=".json", dir=state_dir)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, ensure_ascii=False, separators=(",", ":"))
            handle.write("\n")
        os.replace(temporary, target)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

    return target


def clear_state(session_id: str, state_dir: pathlib.Path | None = None) -> None:
    state_dir = state_dir or default_state_dir()
    target = state_dir / f"{safe_session_id(session_id)}.json"
    if target.exists():
        os.unlink(target)


def cli_state_dir() -> pathlib.Path:
    override = os.environ.get("CODEX_STATUS_LIGHT_DIR")
    if override:
        return pathlib.Path(override).expanduser()
    return default_state_dir()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="codex-status-light")
    parser.add_argument("state", nargs="?", choices=VALID_STATES, help="State to set")
    parser.add_argument("--session", default=os.environ.get("CODEX_SESSION_ID", "manual"))
    parser.add_argument("--turn", default=os.environ.get("CODEX_TURN_ID"))
    parser.add_argument("--message", default="")
    parser.add_argument("--cwd", default="")
    parser.add_argument("--source", default="cli")
    parser.add_argument("--state-dir", default=str(cli_state_dir()))
    parser.add_argument("--streaming", action="store_true", help="When state is running, indicate the assistant is actively streaming output")
    parser.add_argument("--clear", action="store_true", help="Remove this session's status file")
    parser.add_argument("--quiet", action="store_true", help="Suppress non-error output")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    state_dir = pathlib.Path(args.state_dir).expanduser()

    if args.clear:
        clear_state(session_id=args.session, state_dir=state_dir)
        if not args.quiet:
            print(f"Cleared status for session {args.session}")
        return 0

    if args.state is None:
        print("ERROR: state is required unless --clear is used.", file=sys.stderr)
        return 1

    path = write_state(
        state=args.state,
        session_id=args.session,
        turn_id=args.turn,
        message=args.message,
        cwd=args.cwd or os.getcwd(),
        source=args.source,
        state_dir=state_dir,
        is_streaming=args.streaming,
    )
    if not args.quiet:
        print(path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
